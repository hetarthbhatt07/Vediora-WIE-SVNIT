NEXT_PUBLIC_SUPABASE_URL=https://your_project_ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
# Server-only Session Pooler URL used by authenticated clinical API routes.
# Percent-encode special characters in the password.
DATABASE_URL=postgresql://your_database_user:your_encoded_password@your_pooler_host:5432/postgres
# Never expose DATABASE_URL or a service-role key through NEXT_PUBLIC_*.

# Server-only Langfuse Cloud tracing for the medicine-safety workflow.
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# Local Mistral explanation model served by Ollama.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral-nemo:12b
OLLAMA_NUM_GPU=0
